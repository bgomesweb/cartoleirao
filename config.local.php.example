<?php

declare(strict_types=1);

/**
 * ATENÇÃO: copie este arquivo pra "config.local.php" (sem o .example) e
 * preencha com os dados reais do seu hosting. O config.local.php NUNCA deve
 * ir pro Git (já está no .gitignore) — ele fica só no servidor.
 *
 * Esse arquivo só é necessário em hospedagem compartilhada tipo cPanel. No
 * Docker local (desenvolvimento), não crie esse arquivo — as variáveis já
 * vêm do docker-compose.yml + .env normalmente.
 *
 * Onde colocar em produção: FORA da pasta pública (public_html), no
 * diretório raiz do projeto — nunca dentro da pasta que o navegador acessa.
 */

// --- Banco de dados (crie em cPanel > MySQL Databases) ---
putenv('DB_HOST=localhost');
putenv('DB_PORT=3306');
putenv('DB_DATABASE=usuario_cartoleirao');   // nome real do banco no cPanel (com o prefixo da conta)
putenv('DB_USERNAME=usuario_cartoleirao');   // usuário real do banco no cPanel (com o prefixo da conta)
putenv('DB_PASSWORD=TROQUE_ESTA_SENHA');

// --- API do Cartola FC (pública, não precisa mudar) ---
putenv('CARTOLA_API_BASE=https://api.cartola.globo.com');

// --- URL pública do site (usado em textos/links, ajuste pro seu domínio) ---
putenv('APP_URL=https://seudominio.com.br');

// --- E-mails de inscrição/confirmação de pagamento ---
putenv('EMAIL_FROM_ADDRESS=nao-responda@bgomesweb.com.br');
putenv('EMAIL_FROM_NAME=Cartoleirão');
putenv('PIX_KEY=19998970090');
putenv('PIX_RECIPIENT=Bruno Gomes da Silva');
putenv('LEAGUE_ADMIN_NAME=Bruno Gomes');
